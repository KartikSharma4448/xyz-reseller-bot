<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reseller Panel | Dashboard</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #1a1a2e;
            color: #fff;
        }
        .navbar {
            background: linear-gradient(135deg, #16213e, #0f3460);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid #e94560;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .navbar h1 {
            color: #e94560;
            font-size: 24px;
        }
        .navbar .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .navbar a {
            color: #fff;
            text-decoration: none;
            background: rgba(255,255,255,0.1);
            padding: 8px 15px;
            border-radius: 5px;
            font-size: 14px;
            transition: 0.3s;
        }
        .navbar a:hover {
            background: #e94560;
        }
        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
        }
        .card {
            background: #16213e;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            border: 1px solid #0f3460;
        }
        .card h2 {
            margin-bottom: 20px;
            color: #00ff88;
            font-size: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 10px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #aaa;
            font-size: 14px;
        }
        .form-group select, .form-group input {
            width: 100%;
            padding: 12px;
            background: #0f3460;
            border: 1px solid #1a1a2e;
            color: #fff;
            border-radius: 8px;
            outline: none;
            font-size: 15px;
        }
        .form-group input::placeholder {
            color: #555;
        }
        .btn {
            width: 100%;
            padding: 15px;
            background: #e94560;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }
        .btn:hover {
            background: #d63d56;
        }
        .btn-stop {
            background: #ff4444;
        }
        .btn-stop:hover {
            background: #cc0000;
        }
        .bot-status {
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid #00ff88;
            color: #00ff88;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            text-align: center;
            font-weight: bold;
        }
        .bot-status .loader {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #00ff88;
            margin-right: 10px;
            animation: blink 1s infinite alternate;
        }
        @keyframes blink {
            0% { opacity: 0.3; }
            100% { opacity: 1; }
        }
        .history-item {
            background: #0f3460;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            border-left: 4px solid #e94560;
        }
        .history-item .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        .history-item .key-box {
            background: #1a1a2e;
            padding: 10px;
            border-radius: 5px;
            font-family: monospace;
            color: #00ff88;
            word-break: break-all;
            margin-bottom: 10px;
        }
        .empty-state {
            text-align: center;
            color: #888;
            padding: 30px;
        }
        
        /* Terminal Console CSS */
        .console-box {
            background: #000;
            border-radius: 8px;
            padding: 15px;
            margin-top: 25px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 13px;
            color: #0f0;
            height: 250px;
            overflow-y: auto;
            border: 1px solid #333;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        }
        .console-line {
            margin-bottom: 5px;
            word-break: break-all;
        }
        .log-info { color: #00ff88; }
        .log-warning { color: #ffeb3b; }
        .log-error { color: #ff4444; }
        .log-success { color: #00e676; font-weight: bold; }
        .log-time { color: #555; margin-right: 10px; font-size: 11px; }

        @media (max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <h1>🎮 Reseller Panel</h1>
        <div class="user-info">
            <span>Welcome, <%= user.email %></span>
            <a href="/logout">Logout</a>
        </div>
    </nav>

    <div class="container">
        <!-- Target Selection Section -->
        <div class="card">
            <h2>Auto-Bot Target</h2>
            
            <% if (botConfig) { %>
                <div class="bot-status">
                    <span class="loader"></span>
                    Bot is actively checking API for:<br>
                    <span style="color:#fff; font-size:18px; display:inline-block; margin-top:10px;"><%= botConfig.productName %> (<%= botConfig.duration %>)</span>
                </div>
                
                <form action="/bot/stop" method="POST">
                    <button type="submit" class="btn btn-stop">🛑 Stop Bot</button>
                </form>
            <% } else { %>
                <p style="color: #aaa; font-size: 14px; margin-bottom: 15px;">
                    Select the key you want the bot to buy automatically when you have balance.
                </p>
                <form action="/bot/start" method="POST">
                    <div class="form-group">
                        <label>Select Game (Product)</label>
                        <select name="product_id" id="productSelect" required>
                            <option value="" disabled selected>-- Select Product --</option>
                            <% Object.keys(products).forEach(pid => { %>
                                <option value="<%= pid %>"><%= products[pid].name %> (PID: <%= pid %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Select Duration</label>
                        <select name="duration" id="durationSelect" required>
                            <option value="" disabled selected>-- Select Product First --</option>
                        </select>
                    </div>
                    <div class="form-group" id="androidIdGroup" style="display: none;">
                        <label>Android Device ID (Required for V1)</label>
                        <input type="text" name="android_id" placeholder="Leave blank to Auto-Generate">
                    </div>
                    <button type="submit" class="btn">🚀 Start Auto-Bot</button>
                </form>
            <% } %>

            <!-- Live Terminal Console -->
            <h3 style="margin-top:30px; font-size:16px; color:#aaa;">Terminal Logs</h3>
            <div class="console-box" id="consoleOutput">
                <div class="console-line"><span class="log-time"><%= new Date().toLocaleTimeString() %></span><span class="log-info">System initialized... Waiting for events.</span></div>
            </div>
        </div>

        <!-- History Section -->
        <div class="card">
            <h2>Generated Keys</h2>
            <% if (history && history.length > 0) { %>
                <% history.forEach(h => { %>
                    <div class="history-item">
                        <div class="header">
                            <strong style="color: #e94560;"><%= h.product_name || h.productName %></strong>
                            <span style="font-size: 12px; color: #888;"><%= h.time %></span>
                        </div>
                        <div style="font-size: 13px; color: #ccc; margin-bottom: 10px;">Duration: <%= h.duration %></div>
                        <div class="key-box"><%= h.key_value || h.key %></div>
                        <div style="text-align: right;">
                            <button onclick="navigator.clipboard.writeText('<%= h.key_value || h.key %>')" style="background: rgba(255,255,255,0.1); color: #fff; border: none; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 12px;">Copy Key</button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    No keys generated yet.
                </div>
            <% } %>
        </div>
    </div>

    <!-- Pass the products data to frontend JS -->
    <script>
        const productsData = <%- JSON.stringify(products) %>;
        
        const productSelect = document.getElementById('productSelect');
        const durationSelect = document.getElementById('durationSelect');
        const androidIdGroup = document.getElementById('androidIdGroup');

        if (productSelect && durationSelect) {
            productSelect.addEventListener('change', function() {
                const pid = this.value;
                const product = productsData[pid];
                
                // Clear durations
                durationSelect.innerHTML = '';
                
                if (product) {
                    if (product.durations) {
                        product.durations.forEach(dur => {
                            const opt = document.createElement('option');
                            opt.value = dur;
                            opt.textContent = dur;
                            durationSelect.appendChild(opt);
                        });
                    }
                    
                    // Show/Hide Android ID field based on requirement
                    if (product.requiresAndroidId) {
                        androidIdGroup.style.display = 'block';
                    } else {
                        androidIdGroup.style.display = 'none';
                    }
                }
            });
        }

        // --- Live Console (SSE) ---
        const consoleOutput = document.getElementById('consoleOutput');
        
        function appendLog(time, message, type) {
            const line = document.createElement('div');
            line.className = 'console-line';
            line.innerHTML = `<span class="log-time">${time}</span><span class="log-${type}">${message}</span>`;
            consoleOutput.appendChild(line);
            consoleOutput.scrollTop = consoleOutput.scrollHeight; // auto-scroll
        }

        const evtSource = new EventSource("/bot/stream");
        evtSource.onmessage = function(event) {
            const data = JSON.parse(event.data);
            appendLog(data.time, data.message, data.type);
        };
        evtSource.onerror = function(err) {
            console.error("EventSource failed:", err);
        };
    </script>
</body>
</html>
