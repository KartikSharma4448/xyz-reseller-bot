<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reseller Panel | Dashboard</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #1a1a2e;
            color: #fff;
        }
        .navbar {
            background: linear-gradient(135deg, #16213e, #0f3460);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid #e94560;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .navbar h1 {
            color: #e94560;
            font-size: 24px;
        }
        .navbar .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .navbar a {
            color: #fff;
            text-decoration: none;
            background: rgba(255,255,255,0.1);
            padding: 8px 15px;
            border-radius: 5px;
            font-size: 14px;
            transition: 0.3s;
        }
        .navbar a:hover {
            background: #e94560;
        }
        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
        }
        .card {
            background: #16213e;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            border: 1px solid #0f3460;
        }
        .card h2 {
            margin-bottom: 20px;
            color: #00ff88;
            font-size: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 10px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #aaa;
            font-size: 14px;
        }
        .form-group select {
            width: 100%;
            padding: 12px;
            background: #0f3460;
            border: 1px solid #1a1a2e;
            color: #fff;
            border-radius: 8px;
            outline: none;
            font-size: 15px;
        }
        .btn {
            width: 100%;
            padding: 15px;
            background: #e94560;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }
        .btn:hover {
            background: #d63d56;
        }
        .history-item {
            background: #0f3460;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            border-left: 4px solid #e94560;
        }
        .history-item .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        .history-item .key-box {
            background: #1a1a2e;
            padding: 10px;
            border-radius: 5px;
            font-family: monospace;
            color: #00ff88;
            word-break: break-all;
            margin-bottom: 10px;
        }
        .empty-state {
            text-align: center;
            color: #888;
            padding: 30px;
        }
        @media (max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <h1>🎮 XYZ Panel</h1>
        <div class="user-info">
            <span>Welcome, <%= user.email %></span>
            <a href="/logout">Logout</a>
        </div>
    </nav>

    <div class="container">
        <!-- Generate Key Section -->
        <div class="card">
            <h2>Generate New Key</h2>
            <form action="/generate" method="POST">
                <div class="form-group">
                    <label>Select Duration</label>
                    <select name="duration" required>
                        <% prices.forEach(p => { %>
                            <option value="<%= p.duration %>"><%= p.duration %> (₹<%= p.price %>)</option>
                        <% }) %>
                    </select>
                </div>
                <button type="submit" class="btn">🚀 Generate Key</button>
            </form>
        </div>

        <!-- History Section -->
        <div class="card">
            <h2>Recent Keys</h2>
            <% if (history && history.length > 0) { %>
                <% history.forEach(h => { %>
                    <div class="history-item">
                        <div class="header">
                            <strong style="color: #e94560;"><%= h.duration %> - ₹<%= h.price %></strong>
                            <span style="font-size: 12px; color: #888;"><%= h.time %></span>
                        </div>
                        <div class="key-box"><%= h.key %></div>
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 11px; color: #ffc107;">⏰ Expires: <%= h.expiresAt || 'N/A' %></span>
                            <button onclick="navigator.clipboard.writeText('<%= h.key %>')" style="background: rgba(255,255,255,0.1); color: #fff; border: none; padding: 5px 10px; border-radius: 5px; cursor: pointer; font-size: 12px;">Copy</button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    No keys generated yet.
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
